# Terraform working directory
**/.terraform/*

# Terraform state and backups
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files
*.tfplan
tfplan

# Local variable files (keep the example file)
*.tfvars
!*.tfvars.example

# Crash logs
crash.log
crash.*.log

# CLI configuration and override files
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive local files
.env
.env.*
!.env.example

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
